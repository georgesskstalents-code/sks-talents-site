16:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"SKS TALENTS intervient-il uniquement en Life Sciences ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Le cabinet intervient principalement en Life Sciences, diagnostic, santé animale, medtech, cosmétique scientifique et petfood premium, avec une logique de spécialisation sur les marchés techniques.\"}},{\"@type\":\"Question\",\"name\":\"En combien de temps recevez-vous une première shortlist ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sur les missions bien cadrées, une première shortlist peut être présentée sous 10 jours. Le délai complet dépend ensuite du niveau de rareté du poste et de la rapidité de décision côté client.\"}},{\"@type\":\"Question\",\"name\":\"Comment prendre contact avec SKS TALENTS ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Vous pouvez réserver un créneau via Calendly, demander à être rappelé depuis le formulaire inline ou écrire directement à g.kengue@skstalents.com.\"}}]}"}}],["$","section",null,{"className":"container-shell py-16 sm:py-20","children":["$","div",null,{"className":"card-surface p-8 sm:p-12 bg-[radial-gradient(circle_at_top_right,rgba(65,160,164,0.18),transparent_32%),linear-gradient(180deg,rgba(223,243,241,0.95),rgba(255,255,255,0.88))]","children":[["$","nav",null,{"aria-label":"Fil d’Ariane","className":"mb-6 flex flex-wrap items-center gap-2 text-sm text-brand-stone","children":[["$","span","Accueil-0",{"className":"inline-flex items-center gap-2","children":[["$","$L19",null,{"href":"/","className":"transition hover:text-brand-teal","children":"Accueil"}],["$","span",null,{"className":"text-brand-teal/50","children":"/"}]]}],["$","span","Rejoignez-nous-1",{"className":"inline-flex items-center gap-2","children":[["$","span",null,{"className":"font-semibold text-brand-i